const GM=()=>S.gg=S.gg||[],gOf=m=>GM().find(g=>g.models.some(x=>nz(x)==nz(m))),gitem=(gid,ty)=>S.items.find(i=>i.sec=='glass'&&i.gid==gid&&i.ty==ty),gst=i=>i.st||'g';
const hay=i=>[i.brand,i.name,i.color,i.ram,i.cap,i.note,i.rem,i.need,i.kind,i.conn,i.tier].join(' ');
let GS={},CS={},CP=[],PBF={rem:[],need:[],_a:''};

function ch(){$('cc').innerHTML=CP.map(([g,l])=>`<label>${l}</label><div>${(S.tags[g]||[]).map((t,j)=>`<button class="tag ${CS[g]==t?'on':''}" onclick="ck('${g}',${j})">${esc(t)}</button>`).join('')}${CS._a==g?`<span class="row2"><input id="cnew" placeholder="الاسم الجديد"><button class="btn sm" onclick="cok('${g}')">إضافة</button></span>`:`<button class="tag" onclick="CS._a='${g}';ch()">+ جديد</button>`}</div>`).join('')}
function ck(g,j){const v=S.tags[g][j];CS[g]=CS[g]==v?'':v;ch()}
function cok(g){const t=$('cnew').value.trim();if(t){if(!S.tags[g].includes(t))S.tags[g].push(t);CS[g]=t;save()}CS._a='';ch()}

/* ===== 1. الأنتي كاس (إشارات سريعة بدون عدّ بالحبة) ===== */
function glV(){const j=V.ty||0;return{t:'الأنتي كاس',h:`<button class="btn" onclick="glAdd()">+ إضافة موديل</button><div>${S.tags.glass.map((t,k)=>`<button class="tag ${k==j?'on':''}" onclick="V.ty=${k};render()">${esc(t)}</button>`).join('')}</div>`+(GM().map(g=>glCard(g,j)).join('')||'<p class="m">أضف أول موديل لتبدأ المجموعات.</p>')}}

function glCard(g,j){
  const ty=S.tags.glass[j],i=gitem(g.id,ty)||{st:'g'},s=gst(i),L={g:'متوفر',y:'قليل',r:'نفد'};
  return `<div class="card">
    <div class="row2"><b>${esc(g.models.join(' / '))}</b><span class="dotl" style="background:${DT[s]}"></span><span class="m">${TX[s]}${i.price?' · '+esc(i.price)+' د':''}</span></div>
    ${i.note?`<div class="m">📝 ${esc(i.note)}</div>`:''}
    <div style="margin-top:6px">${['g','y','r'].map(k=>`<button class="tag ${s==k?'on':''}" onclick="glSt('${g.id}',${j},'${k}')">${L[k]}</button>`).join('')}</div>
    <div class="sub">
      <button class="btn s sm" onclick="glNote('${g.id}',${j})">ملاحظة / سعر</button>
      <button class="btn s sm" onclick="glM('${g.id}')">+ موديل مطابق</button>
      <button class="btn s sm" onclick="glRm('${g.id}')">حذف موديل</button>
    </div>
  </div>`;
}

function glGet(gid,ty){let i=gitem(gid,ty);if(!i){i={id:uid(),sec:'glass',gid,ty,st:'g',note:'',price:'',by:S.me,at:Date.now()};S.items.push(i)}return i}
function glSt(gid,j,s){const r=glGet(gid,S.tags.glass[j]);upd(()=>{r.st=s;if(s=='g')r.note='';r.by=S.me;r.at=Date.now()})}
function glNote(gid,j){const ty=S.tags.glass[j],i=gitem(gid,ty)||{};ask('ملاحظة وسعر — '+ty,[{k:'n',l:'ملاحظة للمعلم (مثال: بقي 3 حبات)',v:i.note||''},{k:'p',l:'السعر',t:'tel',v:i.price||''}]).then(v=>{if(!v)return;const r=glGet(gid,ty);upd(()=>{r.note=v.n.trim();if(can('price'))r.price=v.p.trim();if(r.note&&r.st=='g')r.st='y';r.by=S.me;r.at=Date.now()})})}
function glAdd(){GS={};$('sh').innerHTML=`<div class="bar"></div><h3>موديل جديد</h3><label>اسم الموديل<input id="gn"></label><button class="btn" onclick="glNext()">التالي</button>`;sheetOpen(()=>{})}
function glNext(){const n=$('gn').value.trim();if(!n)return;if(gOf(n))return toast('هذا الموديل مسجل');GS.n=n;$('sh').innerHTML=`<div class="bar"></div><h3>«${esc(n)}» يطابق أي موديل؟</h3><label>ابحث بين الموديلات<input oninput="glS(this.value)"></label><div id="gl"></div><button class="btn s" onclick="glNew()">لا يطابق شيئاً (مجموعة جديدة)</button>`;glS('')}
function glS(q){const k=nz(q);$('gl').innerHTML=GM().flatMap(g=>g.models.map(m=>({g,m}))).filter(x=>!k||nz(x.m).includes(k)).slice(0,8).map(x=>`<button class="card row2" onclick="glJoin('${x.g.id}')"><b>${esc(x.m)}</b><span class="m">${x.g.models.length} موديلات</span></button>`).join('')}
function glJoin(gid){const g=GM().find(x=>x.id==gid);upd(()=>g.models.push(GS.n));finish(null)}
function glNew(){upd(()=>GM().push({id:uid(),models:[GS.n]}));finish(null)}
function glM(gid){const g=GM().find(x=>x.id==gid);ask('موديل مطابق',[{k:'n',l:'الاسم'}]).then(v=>{const n=v&&v.n.trim();if(!n)return;const o=gOf(n);if(o&&o.id==gid)return toast('موجود في المجموعة');if(!o)return upd(()=>g.models.push(n));sure('«'+n+'» في مجموعة أخرى. دمج المجموعتين؟','دمج',false).then(y=>{if(y)upd(()=>glMerge(g,o))})})}
function glMerge(a,b){b.models.forEach(m=>{if(!a.models.includes(m))a.models.push(m)});S.items=S.items.filter(i=>{if(i.sec!='glass'||i.gid!=b.id)return true;const t=gitem(a.id,i.ty);if(!t){i.gid=a.id;return true}return false});S.gg=GM().filter(x=>x!=b)}
function glRm(gid){const g=GM().find(x=>x.id==gid);ask('حذف موديل من المجموعة',[{k:'m',l:'الموديل',t:'sel',o:g.models,v:g.models[0]}],'حذف',true).then(v=>{if(!v)return;if(!can('del'))return toast('الحذف للمدير فقط');sure('حذف «'+v.m+'» ؟').then(y=>{if(!y)return;upd(()=>{g.models=g.models.filter(m=>m!=v.m);if(!g.models.length){S.gg=GM().filter(x=>x!=g);S.items=S.items.filter(i=>!(i.sec=='glass'&&i.gid==gid))}})})})}
function glB(g){return `<div class="card"><b>زجاج يطابق: ${esc(g.models.join(' / '))}</b>${S.tags.glass.map(t=>{const i=gitem(g.id,t),s=i?gst(i):'g';return `<div class="row2"><span class="dotl" style="background:${DT[s]}"></span><span style="flex:1">${esc(t)}</span><span class="m">${TX[s]}${i&&i.note?' ('+esc(i.note)+')':''}</span></div>`}).join('')}</div>`}

/* ===== 2. البوشيط (إشارات سريعة + شنو باقي وشنو خاصنا بالـ Tags) ===== */
const csSt=i=>i.st||'g';
function csCard(i){
  const s=csSt(i),L={g:'متوفر',y:'قليل',r:'نفد'};
  return `<div class="card">
    <div class="row2"><b>بوشيط ${esc(i.name)}</b><span class="dotl" style="background:${DT[s]}"></span><span class="m">${TX[s]}${i.price?' · '+esc(i.price)+' د':''}</span></div>
    ${i.rem?`<div class="m">🟢 <b>باقي:</b> ${esc(i.rem)}</div>`:''}
    ${i.need?`<div class="rs">🔴 خاصنا: ${esc(i.need)}</div>`:''}
    <div style="margin-top:6px">${['g','y','r'].map(k=>`<button class="tag ${s==k?'on':''}" onclick="csS('${i.id}','${k}')">${L[k]}</button>`).join('')}</div>
    <div class="sub">
      <button class="btn s sm" onclick="csDet('${i.id}')">تحديد الباقي والناقص</button>
      <button class="btn s sm" onclick="csDel('${i.id}')">حذف</button>
    </div>
  </div>`;
}
function csView(){return{t:'البوشيط',h:`<button class="btn" onclick="csAdd()">+ إضافة موديل</button>`+(S.items.filter(i=>i.sec=='case').sort((a,b)=>a.name.localeCompare(b.name)).map(csCard).join('')||'<p class="m">لا شيء بعد</p>')}}
function csS(id,s){const i=find(id);upd(()=>{i.st=s;if(s=='g'){i.rem='';i.need=''}i.by=S.me;i.at=Date.now()})}
function csAdd(){ask('موديل بوشيط جديد',[{k:'n',l:'الهاتف (مثال: Samsung A07)'},{k:'p',l:'السعر (اختياري)',t:'tel',v:'25'}]).then(v=>{const n=v&&v.n.trim();if(!n)return;const d=S.items.find(i=>i.sec=='case'&&nz(i.name)==nz(n));if(d)return toast('الموديل موجود');const r={id:uid(),sec:'case',name:n,price:v.p.trim(),st:'g',rem:'',need:'',by:S.me,at:Date.now()};upd(()=>S.items.push(r))})}

function csDet(id){
  const r=find(id);PR=r;
  const allTags=[...(S.tags.gender||[]),...(S.tags.color||[]),'شفاف','سيليكون','أشكال مزخرفة','ألوان غامقة','ألوان فاتحة'];
  PBF={all:[...new Set(allTags)],rem:r.rem?r.rem.split('، ').filter(Boolean):[],need:r.need?r.need.split('، ').filter(Boolean):[]};
  $('sh').innerHTML=`<div class="bar"></div><h3>بوشيط ${esc(r.name)}</h3>
    <label>🟢 شنو باقي عندنا فالمحل؟</label><div id="pb_rem"></div><input id="in_rem" value="${esc(r.rem||'')}" placeholder="اختر من الأعلى أو اكتب...">
    <label>🔴 شنو خاص يجيب المعلم؟</label><div id="pb_need"></div><input id="in_need" value="${esc(r.need||'')}" placeholder="اختر من الأعلى أو اكتب...">
    <div class="acts"><button class="btn s" onclick="finish(null)">إلغاء</button><button class="btn" onclick="finish({rem:$('in_rem').value.trim(),need:$('in_need').value.trim()})">حفظ</button></div>`;
  sheetOpen(v=>{if(!v)return;commit('تم تحديث البوشيط',()=>{r.rem=v.rem;r.need=v.need;if(r.need&&(!r.st||r.st=='g'))r.st='y';r.by=S.me;r.at=Date.now()})});
  renderPbTags();
}
function renderPbTags(){
  ['rem','need'].forEach(k=>{
    $('pb_'+k).innerHTML=PBF.all.map(t=>`<button class="tag ${PBF[k].includes(t)?'on':''}" onclick="togPb('${k}','${esc(t)}')">${esc(t)}</button>`).join('');
  });
}
function togPb(k,t){
  const inp=$('in_'+k);
  let arr=inp.value.split(/[،,]/).map(s=>s.trim()).filter(Boolean);
  if(arr.includes(t))arr=arr.filter(x=>x!=t);else arr.push(t);
  PBF[k]=arr;inp.value=arr.join('، ');renderPbTags();
}
function csDel(id){del('items',id,find(id).name)}

/* ===== 3. الإكسسوارات ===== */
const acName=i=>[i.kind,i.conn,i.tier&&'فئة '+i.tier,i.brand].filter(Boolean).join(' ');
function acCard(i){const L={g:'متوفر',y:'قليل',r:'نفد'};return `<div class="card"><div class="row2"><b>${esc(acName(i))}</b><span class="dotl" style="background:${DT[i.st]}"></span><b>${esc(i.price)}</b></div>${i.note?`<div class="m">${esc(i.note)}</div>`:''}<div>${['g','y','r'].map(s=>`<button class="tag ${i.st==s?'on':''}" onclick="acS('${i.id}','${s}')">${L[s]}</button>`).join('')}</div><div class="sub"><button class="btn s sm" onclick="acNote('${i.id}')">ملاحظة</button><button class="btn s sm" onclick="acEd('${i.id}')">تعديل</button><button class="btn s sm" onclick="acDel('${i.id}')">حذف</button></div></div>`}
function acView(){const j=V.kk,a=S.items.filter(i=>i.sec=='acc'&&(j==null||i.kind==S.tags.kind[j])).sort((x,y)=>acName(x).localeCompare(acName(y)));
return{t:'الإكسسوارات',h:`<button class="btn" onclick="acAdd()">+ إضافة إكسسوار</button><div><button class="tag ${j==null?'on':''}" onclick="V.kk=null;render()">الكل</button>${S.tags.kind.map((t,k)=>`<button class="tag ${j==k?'on':''}" onclick="V.kk=${k};render()">${esc(t)}</button>`).join('')}</div>`+(a.map(acCard).join('')||'<p class="m">لا شيء بعد</p>')}}
function acS(id,s){const i=find(id);upd(()=>{i.st=s;if(s=='g')i.note='';i.by=S.me;i.at=Date.now()})}
function acNote(id){const i=find(id);ask('ملاحظة للمشتري',[{k:'n',l:'مثال: بقي 5 حبات',v:i.note||''}]).then(v=>{if(v)upd(()=>{i.note=v.n.trim();i.by=S.me;i.at=Date.now()})})}
function acDel(id){del('items',id,acName(find(id)))}
function acAdd(){PR=null;$('sh').innerHTML=`<div class="bar"></div><h3>إضافة إكسسوار</h3><label>ابحث أولاً (مثلاً: micro)<input oninput="acF(this.value)"></label><div id="pr"></div><button class="btn s" onclick="finish(null)">إلغاء</button>`;sheetOpen(acDone);acF('')}
function acF(q){const n=nz(q),m=S.items.filter(i=>i.sec=='acc'&&nz(acName(i)).includes(n)).slice(0,6);$('pr').innerHTML=m.map(i=>`<button class="card row2" onclick="acForm(find('${i.id}'))"><b>${esc(acName(i))}</b><span class="m">${esc(i.price)}</span></button>`).join('')+`<button class="btn" onclick="acForm({})">+ إكسسوار جديد</button>`}
function acEd(id){$('sh').innerHTML='';sheetOpen(acDone);acForm(find(id))}
function acForm(rec){PR=rec;CP=[['kind','النوع'],['conn','الموصل'],['tier','الفئة (السعر)']];CS={kind:rec.kind||'',conn:rec.conn||'',tier:rec.tier||'',_a:''};$('sh').innerHTML=`<div class="bar"></div><h3>${rec.id?'تعديل':'إكسسوار جديد'}</h3><div id="cc"></div><label>الماركة (اختياري)<input id="ab" value="${esc(rec.brand||'')}"></label><label>السعر<input id="ap" type="tel" value="${esc(rec.price||'')}"></label><label>ملاحظة<textarea id="an">${esc(rec.note||'')}</textarea></label><div class="acts"><button class="btn s" onclick="finish(null)">إلغاء</button><button class="btn" onclick="acSave()">حفظ</button></div>`;ch()}
function acSave(){if(!CS.kind)return toast('اختر النوع');finish({kind:CS.kind,conn:CS.conn,tier:CS.tier,brand:$('ab').value.trim(),price:$('ap').value.trim()||CS.tier,note:$('an').value.trim()})}
function acDone(v){if(!v)return;const r=PR;if(r&&r.id)return commit('تم التعديل',()=>Object.assign(r,v,{by:S.me,at:Date.now()}));const d=S.items.find(i=>i.sec=='acc'&&i.kind==v.kind&&i.conn==v.conn&&i.tier==v.tier&&(i.brand||'')==v.brand);if(d)return toast('موجود مسبقاً: '+acName(d));commit('تمت الإضافة',()=>S.items.push({id:uid(),sec:'acc',...v,st:'g',by:S.me,at:Date.now()}))}

/* ===== 4. البحث والتقرير التفاعلي (مع زر تم الشراء الفردي) ===== */
const _card=card;card=function(i){return i.sec=='case'?csCard(i):i.sec=='acc'?acCard(i):_card(i)};
srch=function(q){const n=nz(q);return GM().filter(g=>g.models.some(m=>nz(m).includes(n))).map(glB).join('')+S.items.filter(i=>i.sec!='glass'&&nz(hay(i)).includes(n)).slice(0,30).map(card).join('')||'<p class="m">لا نتائج</p>'};
const _sec=VW.sec;VW.sec=function(){const k=V.k;return k=='glass'?glV():k=='case'?csView():k=='acc'?acView():_sec()};

function repLines(){
  const L=[];
  ph().filter(i=>stOf(i)!='g').forEach(i=>L.push(['الهواتف الناقصة',[i.brand,i.name,i.color,i.cap].filter(Boolean).join(' ')+' (العدد: '+i.cnt+')',stOf(i),`phC('${i.id}',1)`]));
  GM().forEach(g=>S.tags.glass.forEach((t,idx)=>{const i=gitem(g.id,t);if(i&&gst(i)!='g')L.push(['الأنتي كاس',t+': '+g.models.join(' / ')+(i.note?' — '+i.note:''),gst(i),`glSt('${g.id}',${idx},'g')`])}));
  S.items.filter(i=>i.sec=='case'&&csSt(i)!='g').forEach(i=>L.push(['البوشيط',i.name+(i.rem?' — باقي: '+i.rem:'')+(i.need?' — خاصنا: '+i.need:''),csSt(i),`csS('${i.id}','g')`]));
  S.items.filter(i=>i.sec=='acc'&&i.st!='g').forEach(i=>L.push(['الإكسسوارات',acName(i)+(i.note?' — '+i.note:''),i.st,`acS('${i.id}','g')`]));
  return L;
}

function repTxt(){
  const L=repLines(),o=[];
  const availPh=ph().filter(i=>i.cnt>0);
  if(availPh.length){
    o.push('*الهواتف المتوفرة حالياً*');
    availPh.forEach(i=>o.push('🟢 '+[i.brand,i.name,i.color,i.cap].filter(Boolean).join(' ')+' — العدد: '+i.cnt+(i.price?' ('+i.price+' د)':'')));
    o.push('');
  }
  [...new Set(L.map(x=>x[0]))].forEach(k=>{
    o.push('*'+k+'*');
    L.filter(x=>x[0]==k).forEach(x=>o.push((x[2]=='r'?'🔴 ':'🟡 ')+x[1]));
    o.push('');
  });
  return o.join('\n').trim()||'لا نواقص';
}

VW.rep=function(){
  const L=repLines();
  return{
    t:'التقرير',
    h:([...new Set(L.map(x=>x[0]))].map(k=>`<h3>${k}</h3>`+L.filter(x=>x[0]==k).map(x=>`
      <div class="card row2">
        <span class="dotl" style="background:${DT[x[2]]}"></span>
        <span style="flex:1">${esc(x[1])}</span>
        <button class="btn s sm" onclick="${x[3]};toast('تم الشراء ✓')">تم الشراء</button>
      </div>`).join('')).join('')||'<p class="m">لا نواقص حالياً.</p>')
      +`<button class="btn" onclick="location.href='https://wa.me/?text='+encodeURIComponent(repTxt())">إرسال بالواتساب</button>
        <button class="btn s" onclick="navigator.clipboard.writeText(repTxt()).then(()=>toast('تم النسخ'))">نسخ النص</button>`
  };
};
render();
